# ==============================================================================
# AnumatiSetu - Environment Variables Configuration
# "Simplifying Permissions. Connecting People. Enabling Transparency."
# ==============================================================================

# Server / API Configuration
PORT=5000
NODE_ENV=production

# Database Connection URL
# For local dev / serverless SQLite fallback, defaults to file:./dev.db
# For production PostgreSQL / Neon / Supabase, set e.g.:
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/anumatisetu?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="anumatisetu_portal_secure_jwt_secret_governance_2026"
JWT_EXPIRES_IN="7d"

# Client CORS & Public Origin
CLIENT_URL="https://your-anumatisetu-domain.vercel.app"
DEMO_MODE="true"

# Optional Client Build Environment Variable (leave empty for same-domain serverless)
# VITE_API_URL="https://your-api-domain.com"
