{
  "name": "anumatisetu-portal",
  "version": "1.0.0",
  "description": "AnumatiSetu — National Institutional Permission, Approval, Compliance and Monitoring Portal under AICTE APH 2026-27",
  "private": true,
  "scripts": {
    "setup": "npm run setup:server && npm run setup:client",
    "setup:server": "cd server && npm install && npx prisma generate && npx prisma db push && npm run seed",
    "setup:client": "cd client && npm install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npx prisma generate && cd server && npm run build && cd ../client && npm run build",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
